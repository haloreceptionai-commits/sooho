{
 "shots": [
  {
   "i": 0,
   "start": 0.0,
   "end": 3.9,
   "len": 3.9,
   "sharpness": 395.3,
   "colorfulness": 42.2,
   "contrast": 56.2,
   "motion": 0.0075,
   "words": "Rail ends almost touch, yet the gap saves trains. Steel rails get"
  },
  {
   "i": 1,
   "start": 3.9,
   "end": 7.4,
   "len": 3.5,
   "sharpness": 558.9,
   "colorfulness": 67.5,
   "contrast": 63.3,
   "motion": 0.0088,
   "words": "longer when hot and shorter when cold."
  },
  {
   "i": 2,
   "start": 7.4,
   "end": 11.2,
   "len": 3.8,
   "sharpness": 534.8,
   "colorfulness": 75.9,
   "contrast": 65.7,
   "motion": 0.0119,
   "words": "Over a kilometer, a ten-degree rise adds about a finger\u2019s width."
  },
  {
   "i": 3,
   "start": 11.2,
   "end": 14.9,
   "len": 3.7,
   "sharpness": 524.3,
   "colorfulness": 105.7,
   "contrast": 49.3,
   "motion": 0.0085,
   "words": "So why do tracks have gaps, and why do some look gapless?"
  },
  {
   "i": 4,
   "start": 14.9,
   "end": 19.5,
   "len": 4.6,
   "sharpness": 541.3,
   "colorfulness": 68.8,
   "contrast": 62.7,
   "motion": 0.0076,
   "words": "Old lines used jointed rails: two ends bolted with bars, leaving a small space. In winter that space grows;"
  },
  {
   "i": 5,
   "start": 19.5,
   "end": 23.0,
   "len": 3.5,
   "sharpness": 224.0,
   "colorfulness": 97.0,
   "contrast": 53.5,
   "motion": 0.0239,
   "words": "in summer it nearly closes."
  },
  {
   "i": 6,
   "start": 23.0,
   "end": 26.6,
   "len": 3.6,
   "sharpness": 448.0,
   "colorfulness": 44.1,
   "contrast": 56.0,
   "motion": 0.0109,
   "words": "Without room, heat makes rails shove sideways and buckle. The"
  },
  {
   "i": 7,
   "start": 26.6,
   "end": 30.2,
   "len": 3.6,
   "sharpness": 575.3,
   "colorfulness": 71.8,
   "contrast": 55.3,
   "motion": 0.0104,
   "words": "clickety-clack noise came from those joints, not as the goal."
  },
  {
   "i": 8,
   "start": 30.2,
   "end": 34.3,
   "len": 4.1,
   "sharpness": 628.7,
   "colorfulness": 71.0,
   "contrast": 58.5,
   "motion": 0.0068,
   "words": "Today many mainlines weld rails into long continuous lengths. They set the rail at a"
  },
  {
   "i": 9,
   "start": 34.3,
   "end": 37.6,
   "len": 3.3,
   "sharpness": 572.8,
   "colorfulness": 67.7,
   "contrast": 63.1,
   "motion": 0.0096,
   "words": "neutral temperature so forces balance. Clips,"
  },
  {
   "i": 10,
   "start": 37.6,
   "end": 41.1,
   "len": 3.5,
   "sharpness": 411.5,
   "colorfulness": 64.1,
   "contrast": 55.1,
   "motion": 0.0063,
   "words": "anchors, and packed stone hold that stress in place. Still,"
  },
  {
   "i": 11,
   "start": 41.1,
   "end": 44.6,
   "len": 3.5,
   "sharpness": 608.9,
   "colorfulness": 71.9,
   "contrast": 57.5,
   "motion": 0.0092,
   "words": "insulated joints add small gaps where signals need them."
  },
  {
   "i": 12,
   "start": 44.6,
   "end": 50.9,
   "len": 6.3,
   "sharpness": 415.5,
   "colorfulness": 42.8,
   "contrast": 57.1,
   "motion": 0.0134,
   "words": "In deep cold, joints can pull apart and break bolts. In extreme heat, welded rails can kink if not managed."
  },
  {
   "i": 13,
   "start": 50.9,
   "end": 53.6,
   "len": 2.7,
   "sharpness": 596.1,
   "colorfulness": 72.0,
   "contrast": 57.3,
   "motion": 0.0037,
   "words": "Standards tell crews how to control these risks. The"
  },
  {
   "i": 14,
   "start": 53.6,
   "end": 57.6,
   "len": 4.0,
   "sharpness": 320.5,
   "colorfulness": 75.8,
   "contrast": 62.6,
   "motion": 0.0109,
   "words": "answer: give steel space or controlled grip so it can move safely. Like"
  },
  {
   "i": 15,
   "start": 57.6,
   "end": 61.4,
   "len": 3.8,
   "sharpness": 455.8,
   "colorfulness": 64.8,
   "contrast": 63.9,
   "motion": 0.0264,
   "words": "deck boards need gaps, but steel pushes harder, so we plan it."
  },
  {
   "i": 16,
   "start": 61.4,
   "end": 65.1,
   "len": 3.7,
   "sharpness": 636.9,
   "colorfulness": 74.7,
   "contrast": 58.2,
   "motion": 0.0091,
   "words": "That prevents buckles and breaks, and explains the old clickety-clack. Modern"
  },
  {
   "i": 17,
   "start": 65.1,
   "end": 67.77,
   "len": 2.67,
   "sharpness": 594.3,
   "colorfulness": 72.7,
   "contrast": 57.4,
   "motion": 0.0036,
   "words": "mainlines often have no visible gaps at all."
  }
 ],
